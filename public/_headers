# =============================================================================
# Cloudflare Pages — Security Headers
# dakwahtvequipment.pages.dev
# =============================================================================

# ─── Block Sensitive Paths ────────────────────────────────────────────────────
# Block AWS credential paths (common scanner targets)
/.aws/credentials
  X-Robots-Tag: noindex
  Cache-Control: no-store

/.aws/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Block common sensitive files
/.env
  X-Robots-Tag: noindex
  Cache-Control: no-store

/.git/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/wp-admin/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# ─── Global Security Headers (applied to all routes) ─────────────────────────
/*
  # Prevent clickjacking — only allow embedding from trusted Dakwah TV domains
  X-Frame-Options: SAMEORIGIN

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Force HTTPS for 1 year, include subdomains
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Referrer Policy — only send referrer to same origin
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions Policy — disable unused/sensitive browser APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=()

  # XSS Protection (legacy browsers)
  X-XSS-Protection: 1; mode=block

  # Content Security Policy — allow Firebase, Google, WhatsApp, Fonnte, and Dakwah TV embedding
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fkdbgmcphqvejborcesc.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: *; connect-src 'self' https://fkdbgmcphqvejborcesc.supabase.co wss://fkdbgmcphqvejborcesc.supabase.co https://equipment-photo-uploader.dakwahtvteknis.workers.dev https://api.fonnte.com https://*.dakwahtv.com https://*.dakwahtv.my.id https://*.gotenberg.dev http://localhost:* https://demo.gotenberg.dev; frame-src 'self'; frame-ancestors 'self' https://*.pages.dev https://*.dakwahtv.my.id https://dakwahtv.my.id; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me; upgrade-insecure-requests

  # CORS — restrict to same origin by default
  Access-Control-Allow-Origin: https://dakwahtvequipment.pages.dev

  # Remove server fingerprint headers
  X-Powered-By: 

  # Prevent caching of HTML pages (always serve fresh)
  Cache-Control: no-cache, no-store, must-revalidate

# ─── Static Assets — allow caching ───────────────────────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff

/logo-hero.png
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/favicon*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/doodle*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/items-img/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
