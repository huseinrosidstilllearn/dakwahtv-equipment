# Supabase Configuration (Client-side Public Anon)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# WhatsApp Gateway (Fonnte API Token)
VITE_FONNTE_TOKEN=your-fonnte-token-here

# Gotenberg Microservice Endpoint (LibreOffice PDF Converter)
VITE_GOTENBERG_URL=https://gotenberg.yourdomain.com

# Cloudflare R2 Upload Worker
VITE_R2_WORKER_AUTH=Bearer YourWorkerBearerToken
